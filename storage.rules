rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Company logos submitted through the AI Document Generator.
    // Write-only from the website (images, max 5 MB). Nothing is publicly readable.
    match /documentRequests/{company}/{fileName} {
      allow create: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
