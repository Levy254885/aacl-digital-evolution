rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
        : 'none';
    }
    function isSuperAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'Levybatanga@gmail.com' || userRole() == 'super_admin');
    }
    function isAdmin() {
      return isSuperAdmin() || userRole() == 'admin';
    }
    function isEditor() {
      return isAdmin() || userRole() in ['editor', 'consultant'];
    }

    match /contactLeads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'phone',
          'org',
          'service',
          'message',
          'timestamp',
          'source'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'service', 'message', 'timestamp', 'source'
        ])
        && (!('phone' in request.resource.data)
          || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32))
        && (!('org' in request.resource.data)
          || (request.resource.data.org is string && request.resource.data.org.size() <= 160))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 160
        && request.resource.data.service is string
        && request.resource.data.service.size() >= 2
        && request.resource.data.service.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 5000
        && request.resource.data.source == 'aacl-website'
        && request.resource.data.timestamp == request.time;

      allow read, update, delete: if false;
    }

    match /documentRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'templateSlug', 'templateName', 'standard', 'companyName', 'contactName',
          'email', 'country', 'scope', 'requirements', 'amount', 'currency',
          'paymentMethod', 'paymentReference', 'logoUrl', 'status', 'timestamp', 'source'
        ])
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() >= 2
        && request.resource.data.companyName.size() <= 160
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.templateSlug is string
        && request.resource.data.templateSlug.size() <= 80
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.requirements.size() <= 5000
        && request.resource.data.source == 'aacl-website'
        && request.resource.data.timestamp == request.time;

      allow read, update, delete: if false;
    }

    match /cms/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /auditLog/{entryId} {
      allow read, list: if isAdmin();
      allow create: if isEditor()
        && request.resource.data.keys().hasOnly([
          'action', 'target', 'targetLabel', 'summary', 'actorUid', 'actorEmail', 'at'
        ])
        && request.resource.data.action in [
          'content.publish', 'content.reset', 'role.assign', 'role.remove'
        ]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 120
        && request.resource.data.targetLabel is string
        && request.resource.data.targetLabel.size() <= 160
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Commerce orders (templates + eCompliance). Public create; admin read/update.
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'kind', 'status', 'amount', 'currency', 'paymentMethod', 'reference',
          'email', 'customerName', 'source'
        ])
        && request.resource.data.kind in ['template', 'ecompliance']
        && request.resource.data.status in ['pending', 'awaiting_payment']
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.currency is string
        && request.resource.data.currency.size() <= 8
        && request.resource.data.paymentMethod in ['mpesa', 'card', 'paypal']
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 6
        && request.resource.data.reference.size() <= 48
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 160
        && request.resource.data.source == 'aacl-website';

      allow read, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.reference == resource.data.reference
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isSuperAdmin();
    }

    match /roles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
